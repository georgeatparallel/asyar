{
  "name": "asyar-parallel-search-extension",
  "version": "1.0.0",
  "description": "Parallel Search web search engine for Asyar's AI agent",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "validate": "asyar validate",
    "pack": "asyar pack",
    "publish": "asyar publish",
    "link": "asyar link",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "keytar"
    ]
  },
  "devDependencies": {
    "asyar-sdk": "^4.22.0",
    "prettier": "^3.9.4",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^2.1.0"
  }
}
